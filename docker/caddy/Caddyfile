# Caddy em produção: um endereço só para o painel e a API (como o Vite faz em desenvolvimento), sem CORS.
# DOMINIO = o domínio do painel (ex.: painel.terra.agr.br): o Caddy tira e renova o certificado HTTPS sozinho.
# Para testar sem domínio, DOMINIO=:80 serve só HTTP.
{
	email {$EMAIL_HTTPS}
}

{$DOMINIO} {
	encode zstd gzip

	# a API
	handle /api/* {
		reverse_proxy api:8000
	}

	# o painel: os arquivos do build; uma rota do React (ex.: /rebanho/movimentacao) cai no index.html
	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	# os arquivos de /assets têm o hash no nome: podem ficar em cache para sempre; o index.html, nunca
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pagina path / /index.html
	header @pagina Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
