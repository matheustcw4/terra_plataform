# Copie para .env (nunca versionar o .env). Valores abaixo são só para desenvolvimento local.

# --- Postgres (docker compose) ---
POSTGRES_DB=terra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
APP_USER_PASSWORD=troque-app-user
APP_ETL_PASSWORD=troque-app-etl

# --- Backend ---
# URLs montadas a partir das variáveis acima (ver app/core/config.py); sobrescreva se precisar.
# DATABASE_URL_MIGRACAO=postgresql+psycopg://postgres:...@127.0.0.1:55432/terra
AMBIENTE=dev

# --- Fontes ---
# As planilhas chegam só pela tela "Importar planilhas" e o Metryx pela API (o Google Drive deixou de ser fonte em
# 10/11/2026). A carga em massa de uma pasta local pede a pasta: `python -m app.etl planilhas --pasta DIR`.
# Chave Fernet que cifra os tokens Metryx no banco. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
METRYX_CHAVE_CIFRA=
# Datalake do BI de planilhas (Pentaho), só leitura: fonte da carga única do histórico (python -m app.etl
# planilhas-historico). Formato conninfo do psycopg.
# DATALAKE_PLAN_URL=host=127.0.0.1 port=5432 dbname=DATALAKE_PLAN user=postgres

# --- API ---
# Chave que assina os tokens de login: pelo menos 32 caracteres aleatórios. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
# Validade do login em minutos e endereços do front que podem chamar a API
# JWT_MINUTOS=480
# CORS_ORIGENS=http://localhost:5173
