# Produção (VPS): copie para .env.producao, preencha e proteja (chmod 600). Nunca versionar o .env.producao.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.producao up -d --build
# Senhas e chaves: gere aleatórias, por exemplo
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Endereço do painel (o DNS do domínio aponta para o IP da VPS) ---
DOMINIO=painel.exemplo.com.br
EMAIL_HTTPS=ti@exemplo.com.br

# --- Banco (Postgres no próprio compose; escuta só em 127.0.0.1 da VPS) ---
POSTGRES_DB=terra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_USER_PASSWORD=
APP_ETL_PASSWORD=
# porta local da VPS para túnel SSH de manutenção (ssh -L ...)
POSTGRES_PORTA_LOCAL=55432

# --- API ---
# chave que assina os logins: pelo menos 32 caracteres aleatórios
JWT_SEGREDO=
JWT_MINUTOS=480

# --- Cargas agendadas (formato do cron: minuto hora dia mês dia-da-semana; horário de Cuiabá; vazio desliga) ---
AGENDA_PLANILHAS=0 */2 * * *
# Metryx desligado até a autorização das chamadas à API real (CLAUDE.md, Segurança). Exemplo: 0 3 * * *
AGENDA_METRYX=
AGENDA_ESTOQUE=30 0 1 * *
# chave Fernet que cifra os tokens Metryx no banco:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
METRYX_CHAVE_CIFRA=

# --- Pastas da VPS ---
# onde ficam as planilhas que o worker lê (o rclone do perfil "drive" grava aqui)
PLANILHAS_HOST_DIR=/srv/terra/planilhas
# backups diários do banco
BACKUP_HOST_DIR=/srv/terra/backups
HORA_DO_BACKUP=03:00
DIAS_DE_BACKUP=14

# --- Planilhas pelo Google Drive (perfil "drive", opcional) ---
# a pasta rclone.conf (configurada com `rclone config`, remoto do Google Drive só leitura)
RCLONE_CONFIG_DIR=/srv/terra/rclone
# remoto:pasta no Drive
RCLONE_ORIGEM=drive:Relatórios
INTERVALO_DO_DRIVE_S=600
